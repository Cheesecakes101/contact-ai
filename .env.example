# Required for AI features (structuring, natural-language search, web enrichment, reconnect drafts).
# Without it the app still works using simple keyword fallbacks.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: protect your private contacts with a passcode.
# Contact Drop rooms (/drop) stay public so attendees can join without an account.
# APP_PASSCODE=

# Optional: text a WhatsApp number to add/update contacts (see src/app/api/whatsapp/webhook/route.ts).
# Needs a Meta developer app with the WhatsApp Business product added.
# WHATSAPP_VERIFY_TOKEN=     # any string you choose; enter the same value in Meta's webhook setup
# WHATSAPP_ACCESS_TOKEN=     # from the Meta app's WhatsApp > API Setup page
# WHATSAPP_PHONE_NUMBER_ID=  # from the same page
# WHATSAPP_APP_SECRET=       # from the Meta app's Basic Settings; enables webhook signature verification
# OWNER_WHATSAPP_NUMBER=     # your number, e.g. 14155550134 — only messages from this number are processed
