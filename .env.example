# Required for AI features (structuring, natural-language search, web enrichment, reconnect drafts).
# Without it the app still works using simple keyword fallbacks.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: protect your private contacts with a passcode.
# Contact Drop rooms (/drop) stay public so attendees can join without an account.
# APP_PASSCODE=
